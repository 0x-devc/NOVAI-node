# NOVAI stress framework configuration (example).
# Copy to stress.env and edit, or export these in your shell before running.
# All defaults are LOCAL and SAFE. Do not point this at a remote endpoint.

# Validator count in the local cluster.
# STRESS_NODES=4

# Cluster host. Localhost only; the framework refuses non-local targets.
# STRESS_HOST=127.0.0.1

# Port bases (match the repo convention: P2P 9000+i, metrics 8080+i, rpc 3030+i).
# STRESS_P2P_BASE=9000
# STRESS_METRICS_BASE=8080
# STRESS_RPC_BASE=3030

# Runtime directories. Kept under $HOME, gitignored, never committed.
# STRESS_LOG_DIR="$HOME/.novai/stress-logs"
# STRESS_DATA_DIR="$HOME/.novai/stress-data"
# STRESS_REPORT_DIR="$HOME/.novai/stress-reports"

# Gate for destructive scenarios (kill-node, high-rate load). 0 = off.
# STRESS_ENABLE_DESTRUCTIVE=0

# curl connect timeout (seconds) for metric and RPC probes.
# STRESS_CONNECT_TIMEOUT=3

# Consensus round bound used by soak assertions (Phase 2).
# STRESS_ROUND_MAX=20

# Soak duration and sample interval in seconds (Phase 2).
# STRESS_DURATION=120
# STRESS_INTERVAL=5

# --- Cluster bring-up (full-mesh local devnet) ---

# Path to the node binary (default: <repo>/target/release/novai-node).
# STRESS_NODE_BIN="$HOME/path/to/target/release/novai-node"

# Expected connected peers per node. Full mesh = node count minus one.
# STRESS_EXPECTED_PEERS=3

# Consensus knobs passed to each node (milliseconds).
# STRESS_BASE_TIMEOUT=1000
# STRESS_PROPOSAL_INTERVAL=5

# Readiness wait and state-root sampling.
# STRESS_READY_TIMEOUT=60
# STRESS_SAMPLE_MARGIN=1

# Minimum block progress required across the soak window.
# STRESS_MIN_PROGRESS=1
