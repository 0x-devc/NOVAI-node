# NOVAI @@NAME@@ environment template.
# Copy to @@ENV_PATH@@ and edit. The systemd unit loads it.

# SAFETY: DRY_RUN is ON by default. The agent constructs and logs the signal it would
# submit, without contacting the chain. Flipping this to 0 enables live on-chain
# submission and is a deliberate supervised step.
@@NS@@_DRY_RUN=1

# Local NOVAI node JSON-RPC endpoint. Only contacted when DRY_RUN=0.
@@NS@@_RPC_ENDPOINT=http://localhost:3030

# Keypair file (funder + entity seeds). bootstrap.py writes it; oracle.py reads.
# Secret: contains ed25519 seeds. Mode 0600.
@@NS@@_KEY_PATH=@@KEY_PATH@@

# Data source. Read-only HTTP GET; not a chain RPC. The fetch and parser are
# human-authored in lib/@@SOURCE_MODULE@@.py (shipped as a contract stub).
@@NS@@_SOURCE_URL=@@SOURCE_URL@@
@@NS@@_SOURCE_ID=@@SOURCE_ID@@

# Anchor tag, indexed by the chain. Must be 1..32 bytes.
@@NS@@_DATA_TAG=@@DATA_TAG@@

# Prometheus metrics: bind localhost only.
@@NS@@_METRICS_HOST=127.0.0.1
@@NS@@_METRICS_PORT=@@METRICS_PORT@@

# Loop cadence and per-request HTTP timeout (seconds).
@@NS@@_LOOP_INTERVAL_SECS=@@LOOP_INTERVAL@@
@@NS@@_HTTP_TIMEOUT_SECS=@@HTTP_TIMEOUT@@

# Run a single cycle and exit (used for the dry-run demonstration).
@@NS@@_RUN_ONCE=0

# Anchor fields and fee.
@@NS@@_EXPIRY_HEIGHT=0
@@NS@@_ANCHOR_FEE=@@ANCHOR_FEE@@

# Nonce used only to assemble the DRY_RUN transaction envelope. Never sent anywhere.
@@NS@@_DRY_RUN_NONCE=0

# Live-only two-tier balance management (ignored in DRY_RUN).
@@NS@@_ENTITY_MIN_BALANCE=@@ENTITY_MIN_BALANCE@@
@@NS@@_ACCOUNT_MIN_BALANCE=@@ACCOUNT_MIN_BALANCE@@
@@NS@@_CREDIT_AMOUNT=@@CREDIT_AMOUNT@@
@@NS@@_CREDIT_RETRY_AFTER_SECS=300
@@NS@@_FAUCET_RETRY_AFTER_SECS=3600

@@NS@@_LOG_LEVEL=INFO

# Opt-in read-only collision pre-flight at bootstrap time (reads only, never writes):
# @@NS@@_CHECK_ENDPOINT=http://localhost:3030
# Persist generated keys during a dry-run bootstrap (off by default):
# @@NS@@_BOOTSTRAP_WRITE_KEYS=0
