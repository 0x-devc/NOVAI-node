# NOVAI price-oracle configuration.
# Copy to /etc/novai/oracle.env on the host and chmod 0600 root:root.

# Chain endpoint (local node).
PRICE_ORACLE_RPC_ENDPOINT=http://localhost:3030

# Keypair + derived public info. bootstrap.py writes; oracle.py reads.
PRICE_ORACLE_KEY_PATH=/etc/novai/oracle-keys.json

# CoinGecko free-tier endpoint for BTC/USD spot.
PRICE_ORACLE_COINGECKO_URL=https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd

# Prometheus metrics: localhost only by design (the local monitor scrapes it).
PRICE_ORACLE_METRICS_HOST=127.0.0.1
PRICE_ORACLE_METRICS_PORT=9201

# Loop cadence and HTTP timeout. 60s is well under CoinGecko's free-tier
# limit and matches the locked architecture.
PRICE_ORACLE_LOOP_INTERVAL_SECS=60
PRICE_ORACLE_HTTP_TIMEOUT_SECS=10

# Anchor tag and log verbosity.
PRICE_ORACLE_DATA_TAG=price/BTC-USD
PRICE_ORACLE_LOG_LEVEL=INFO
