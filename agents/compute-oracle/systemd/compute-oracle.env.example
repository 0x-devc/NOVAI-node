# NOVAI compute-oracle environment template.
# Copy to /etc/novai/compute-oracle.env and edit. The systemd unit loads it.

# SAFETY: DRY_RUN is ON by default. The agent constructs and logs the signal
# it would submit, without contacting the chain. Flipping this to 0 enables
# live on-chain submission and is a deliberate supervised step.
COMPUTE_ORACLE_DRY_RUN=1

# Local NOVAI node JSON-RPC endpoint. Only contacted when DRY_RUN=0.
COMPUTE_ORACLE_RPC_ENDPOINT=http://localhost:3030

# Keypair file (funder + entity seeds). bootstrap.py writes it; oracle.py reads.
# Secret: contains ed25519 seeds. Mode 0600.
COMPUTE_ORACLE_KEY_PATH=/etc/novai/compute-oracle-keys.json

# Public GPU rental marketplace bundles endpoint. Read-only HTTP GET; not a
# chain RPC. The parser expects a JSON object with an "offers" list, each
# offer carrying gpu_name, dph_total, and num_gpus.
COMPUTE_ORACLE_SOURCE_URL=https://console.vast.ai/api/v0/bundles/

# Stable identifier of the source, hashed into the anchor as source_hash.
COMPUTE_ORACLE_SOURCE_ID=vast.ai/api/v0/bundles

# Target GPU model. The observation is the median per-GPU on-demand USD per
# hour across currently-listed offers whose gpu_name matches this model.
COMPUTE_ORACLE_GPU_MODEL=RTX 4090

# Anchor tag, indexed by the chain. Must be 1..32 bytes.
COMPUTE_ORACLE_DATA_TAG=compute/rtx4090-usd-hr

# Prometheus metrics: bind localhost only. Agent #2 reserves 9202 (9200+N).
COMPUTE_ORACLE_METRICS_HOST=127.0.0.1
COMPUTE_ORACLE_METRICS_PORT=9202

# Loop cadence and per-request HTTP timeout (seconds).
COMPUTE_ORACLE_LOOP_INTERVAL_SECS=300
COMPUTE_ORACLE_HTTP_TIMEOUT_SECS=10

# Run a single cycle and exit (used for the dry-run demonstration).
COMPUTE_ORACLE_RUN_ONCE=0

# Anchor fields and fee.
COMPUTE_ORACLE_EXPIRY_HEIGHT=0
COMPUTE_ORACLE_ANCHOR_FEE=1000

# Nonce used only to assemble the DRY_RUN transaction envelope. The live path
# fetches the real nonce at submit time; this value is never sent anywhere.
COMPUTE_ORACLE_DRY_RUN_NONCE=0

# Optional ReputationUpdate (signal type 7) demonstration. Disabled by default.
# When enabled, set a 32-byte hex target entity id. event_type must be a valid
# REP_EVENT_* discriminant for live use.
COMPUTE_ORACLE_REPUTATION_ENABLED=0
COMPUTE_ORACLE_REPUTATION_FEE=1000
COMPUTE_ORACLE_REPUTATION_TARGET=
COMPUTE_ORACLE_REPUTATION_EVENT_TYPE=0
COMPUTE_ORACLE_REPUTATION_POINTS_DELTA=0

# Live-only two-tier balance management (ignored in DRY_RUN).
COMPUTE_ORACLE_ENTITY_MIN_BALANCE=5000
COMPUTE_ORACLE_ACCOUNT_MIN_BALANCE=200000
COMPUTE_ORACLE_CREDIT_AMOUNT=100000
COMPUTE_ORACLE_CREDIT_RETRY_AFTER_SECS=300
COMPUTE_ORACLE_FAUCET_RETRY_AFTER_SECS=3600

COMPUTE_ORACLE_LOG_LEVEL=INFO
