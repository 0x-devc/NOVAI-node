# /etc/novai/monitor.env  chmod 0600 root:root
#
# Cross-node monitor. By default it polls all four validators over loopback:
# metrics on 8080..8083 and RPC on 3030..3033, derived from the base ports
# below. It alerts on per-node stuck, cluster halt, fault tolerance from
# healthy validator count (NOT transport peer_count), state_root divergence,
# node unreachable, and host disk/memory pressure.
#
# Node list precedence:
#   1. NOVAI_MONITOR_NODES (explicit list) wins if set.
#   2. else NOVAI_MONITOR_NODE_COUNT derives node0..node{N-1} from the bases.
#   3. else the legacy single NOVAI_MONITOR_METRICS_URL runs one node, with the
#      cross-node alerts inert. This keeps an old single-node deploy working.
#   4. else default to four derived nodes.

NOVAI_MONITOR_NODE_COUNT="4"
NOVAI_MONITOR_HOST="localhost"
NOVAI_MONITOR_METRICS_BASE_PORT="8080"
NOVAI_MONITOR_RPC_BASE_PORT="3030"

# Explicit override, comma separated label@metrics_url@rpc_url (optional):
# NOVAI_MONITOR_NODES="node0@http://localhost:8080/metrics@http://localhost:3030,node1@http://localhost:8081/metrics@http://localhost:3031"

# Legacy single-node URL (used only if NODE_COUNT and NODES are both unset):
# NOVAI_MONITOR_METRICS_URL="http://localhost:8080/metrics"

# Basic auth, only needed for an off-host nginx-fronted metrics endpoint:
NOVAI_MONITOR_METRICS_USER=""
NOVAI_MONITOR_METRICS_PASS=""

NOVAI_MONITOR_POLL_INTERVAL_SECS="30"
NOVAI_MONITOR_HTTP_TIMEOUT_SECS="5"
NOVAI_MONITOR_REARM_GRACE_SECS="120"

# Cross-node divergence (RPC state_root comparison) and host disk/mem checks.
NOVAI_MONITOR_DIVERGENCE_ENABLED="true"
NOVAI_MONITOR_HOST_CHECKS_ENABLED="true"
NOVAI_MONITOR_DISK_PATH="/"

# Required for live alerts; see README.md for the @BotFather walkthrough.
NOVAI_MONITOR_TELEGRAM_BOT_TOKEN="REPLACE_ME"
NOVAI_MONITOR_TELEGRAM_CHAT_ID="REPLACE_ME"

NOVAI_MONITOR_LOG_LEVEL="INFO"
NOVAI_MONITOR_ENV_LABEL="prod-1"
