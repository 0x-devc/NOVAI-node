# /etc/novai/monitor.env — chmod 0600 root:root
#
# Default polls the local node over plain HTTP on loopback. Switch to
# https://metrics.novai.network/metrics with USER and PASS set if you
# need to monitor through the nginx-fronted public endpoint instead.

NOVAI_MONITOR_METRICS_URL="http://localhost:8081/metrics"
NOVAI_MONITOR_METRICS_USER=""
NOVAI_MONITOR_METRICS_PASS=""

NOVAI_MONITOR_POLL_INTERVAL_SECS="30"
NOVAI_MONITOR_HTTP_TIMEOUT_SECS="10"
NOVAI_MONITOR_REARM_GRACE_SECS="120"
NOVAI_MONITOR_UNREACHABLE_THRESHOLD_SECS="120"

# Required for live alerts; see README.md for @BotFather walkthrough.
NOVAI_MONITOR_TELEGRAM_BOT_TOKEN="REPLACE_ME"
NOVAI_MONITOR_TELEGRAM_CHAT_ID="REPLACE_ME"

NOVAI_MONITOR_LOG_LEVEL="INFO"
NOVAI_MONITOR_ENV_LABEL="prod-1"
